{
  "model": "emilyalsentzer/Bio_ClinicalBERT",
  "task": "Clinical named entity recognition for nursing handover",
  "labels": [
    "O",
    "B-Demographics_Bed",
    "I-Demographics_Bed",
    "B-Demographics_Name",
    "I-Demographics_Name",
    "B-Demographics_Age",
    "I-Demographics_Age",
    "B-Demographics_Gender",
    "I-Demographics_Gender",
    "B-Demographics_Doctor",
    "I-Demographics_Doctor",
    "B-Clinical_Condition",
    "I-Clinical_Condition",
    "B-Clinical_Observation",
    "I-Clinical_Observation",
    "B-Medication",
    "I-Medication",
    "B-Investigation_Procedure",
    "I-Investigation_Procedure",
    "B-Plan_Goal",
    "I-Plan_Goal",
    "B-Care_Activity",
    "I-Care_Activity"
  ],
  "metrics": {
    "strict": {
      "precision": 25.22,
      "recall": 53.57,
      "f1": 34.3,
      "tp": 255,
      "fp": 756,
      "fn": 221
    },
    "lenient": {
      "precision": 45.9,
      "recall": 97.48,
      "f1": 62.41,
      "tp": 464,
      "fp": 547,
      "fn": 12
    }
  },
  "dataset": {
    "gold": "NICTA/ANU Synthetic Nursing Handover (Suominen et al., 101 notes)",
    "augmentation": "160 de-identified ISBAR hospital notes",
    "held_out": "gold fold_0 test documents only",
    "train_documents": 240,
    "test_documents": 21
  },
  "training": {
    "epochs": 3,
    "lr": 3e-05,
    "batch_size": 4,
    "max_length": 256,
    "trainable_last_n": 2,
    "final_weighted_loss": 0.5423,
    "device": "cpu",
    "deployment_retrain": true,
    "deployment_loss": 0.7604
  },
  "disclaimer": "PULSE organizes handover text. It does not diagnose or treat."
}