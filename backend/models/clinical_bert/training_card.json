{
  "model": "emilyalsentzer/Bio_ClinicalBERT",
  "task": "Clinical named entity recognition for nursing handover",
  "labels": [
    "O",
    "B-Demographics_Bed",
    "I-Demographics_Bed",
    "B-Demographics_Name",
    "I-Demographics_Name",
    "B-Demographics_Age",
    "I-Demographics_Age",
    "B-Demographics_Gender",
    "I-Demographics_Gender",
    "B-Demographics_Doctor",
    "I-Demographics_Doctor",
    "B-Clinical_Condition",
    "I-Clinical_Condition",
    "B-Clinical_Observation",
    "I-Clinical_Observation",
    "B-Medication",
    "I-Medication",
    "B-Investigation_Procedure",
    "I-Investigation_Procedure",
    "B-Plan_Goal",
    "I-Plan_Goal",
    "B-Care_Activity",
    "I-Care_Activity"
  ],
  "metrics": {
    "strict": {
      "precision": 46.73,
      "recall": 69.12,
      "f1": 55.76,
      "tp": 329,
      "fp": 375,
      "fn": 147
    },
    "lenient": {
      "precision": 64.77,
      "recall": 95.8,
      "f1": 77.29,
      "tp": 456,
      "fp": 248,
      "fn": 20
    }
  },
  "dataset": {
    "gold": "NICTA/ANU Synthetic Nursing Handover (Suominen et al.) \u2014 101 adjudicated ward notes",
    "augmentation": "160 de-identified ISBAR hospital notes",
    "held_out": "gold fold_0 test documents only",
    "train_documents": 240,
    "test_documents": 21
  },
  "training": {
    "epochs": 9,
    "lr": 5e-05,
    "batch_size": 8,
    "max_length": 256,
    "trainable_last_n": 4,
    "final_weighted_loss": 0.062,
    "total_time_s": 1192.1,
    "device": "cpu"
  },
  "disclaimer": "PULSE organizes handover text. It does not diagnose or treat."
}