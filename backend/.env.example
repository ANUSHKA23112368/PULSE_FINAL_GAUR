# PULSE storage configuration
#
# Leave MONGODB_URI empty to use the local SQLite prototype database
# (backend/pulse_prototype.db). Set it to persist patients, handover notes,
# extractions, clinician reviews and pending tasks in MongoDB Atlas instead.
#
# Copy this file to backend/.env, then paste the connection string from
# MongoDB Atlas -> Connect -> Drivers. Never commit backend/.env.
MONGODB_URI=
MONGODB_DB=pulse
